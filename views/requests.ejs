<!DOCTYPE html><html lang="en"><head><meta charset="UTF-8"><meta name="viewport" content="width=device-width,initial-scale=1.0"><title>Resource Requests | DRRMS</title><link rel="stylesheet" href="/css/admin.css"><link rel="stylesheet" href="/css/dashboard.css"></head><body><div class="dashboard"><%- include('partials/sidebar') %><div class="main-content"><%- include('partials/topbar',{pageTitle:'Resource Requests'}) %><main class="content"><div class="page-head"><div><h2>Resource Requests</h2><p class="page-sub">Review and track resource request information.</p></div></div><div class="table-box"><div class="table-responsive"><table><thead><tr><th>Resource</th><th>Category</th><th>Quantity</th><th>Victim</th><th>Volunteer</th><th>Status</th><th>Date</th></tr></thead><tbody><% if(requests.length){ requests.forEach(r=>{ %><tr><td><%= r.resourceName %></td><td><%= r.category %></td><td><%= r.quantity %> <%= r.unit %></td><td><%= r.victim ? r.victim.name : (user.role==='Victim'?user.name:'—') %></td><td><%= r.volunteer ? r.volunteer.name : 'Not assigned' %></td><td><span class="status-pill"><%= r.status %></span></td><td><%= r.createdAt ? new Date(r.createdAt).toLocaleDateString() : '—' %></td></tr><% }) } else { %><tr><td colspan="7" class="empty-state">No resource requests found yet.</td></tr><% } %></tbody></table></div></div></main><%- include('partials/footer') %></div></div></body></html>