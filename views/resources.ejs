<!DOCTYPE html><html lang="en"><head><meta charset="UTF-8"><meta name="viewport" content="width=device-width,initial-scale=1.0"><title>Resource Management | DRRMS</title><link rel="stylesheet" href="/css/admin.css"><link rel="stylesheet" href="/css/dashboard.css"></head><body><div class="dashboard"><%- include('partials/sidebar') %><div class="main-content"><%- include('partials/topbar',{pageTitle:'Resource Management'}) %><main class="content"><div class="page-head"><div><h2>Resource Management</h2><p class="page-sub">Add and review relief resources available for distribution.</p></div></div><div class="table-box"><h2>Add New Resource</h2><form method="POST" action="/admin/resources"><input name="resourceName" placeholder="Resource name" required><input name="category" placeholder="Category" required><input name="unit" placeholder="Unit (e.g. kg, packet)" required><input type="number" min="0" name="availableStock" placeholder="Available stock" required><input type="number" min="0" name="totalStock" placeholder="Total stock" required><button type="submit">Add Resource</button></form></div><div class="table-box"><h2>Available Resources</h2><div class="table-responsive"><table><thead><tr><th>Resource</th><th>Category</th><th>Unit</th><th>Available</th><th>Total</th></tr></thead><tbody><% if(resources.length){ resources.forEach(r=>{ %><tr><td><%= r.resourceName %></td><td><%= r.category %></td><td><%= r.unit %></td><td><%= r.availableStock %></td><td><%= r.totalStock %></td></tr><% }) } else { %><tr><td colspan="5" class="empty-state">No resources added yet.</td></tr><% } %></tbody></table></div></div></main><%- include('partials/footer') %></div></div></body></html>