<!DOCTYPE html><html lang="en"><head><meta charset="UTF-8"><meta name="viewport" content="width=device-width,initial-scale=1.0"><title>Disaster Reports | DRRMS</title><link rel="stylesheet" href="/css/admin.css"><link rel="stylesheet" href="/css/dashboard.css"></head><body><div class="dashboard"><%- include('partials/sidebar') %><div class="main-content"><%- include('partials/topbar',{pageTitle:'Disaster Reports'}) %><main class="content"><div class="page-head"><div><h2>Disaster Reports</h2><p class="page-sub">Reported disaster incidents and affected areas.</p></div></div><div class="table-box"><div class="table-responsive"><table><thead><tr><th>Area</th><th>Disaster</th><th>People Affected</th><th>Reported By</th><th>Status</th><th>Date</th></tr></thead><tbody><% if(reports.length){ reports.forEach(r=>{ %><tr><td><%= r.areaName %></td><td><%= r.disasterType %></td><td><%= r.numberOfVictims %></td><td><%= r.victim ? r.victim.name : '—' %></td><td><span class="status-pill"><%= r.status %></span></td><td><%= r.createdAt ? new Date(r.createdAt).toLocaleDateString() : '—' %></td></tr><% }) } else { %><tr><td colspan="6" class="empty-state">No disaster reports found yet.</td></tr><% } %></tbody></table></div></div></main><%- include('partials/footer') %></div></div></body></html>